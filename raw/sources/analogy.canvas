{
	"nodes":[
		{"id":"title1","type":"text","text":"**<center><font color=\"#00b0f0\">🔬 ANALOGI</font></center>**\n<center>Prima : Komposit</center>\n<center>Atom  : Molekul</center>","x":-50,"y":-620,"width":310,"height":110,"color":"4"},
		{"id":"header_left","type":"text","text":"**<center><font color=\"#92d050\">📐 BILANGAN</font></center>**","x":-420,"y":-440,"width":230,"height":80,"color":"2"},
		{"id":"header_right","type":"text","text":"**<center><font color=\"#ffc000\">⚛️ KIMIA</font></center>**","x":330,"y":-440,"width":230,"height":80,"color":"3"},
		{"id":"unit_num","type":"text","text":"**<center><font color=\"#92d050\">1 — Unit</font></center>**\nBukan prima maupun komposit\nHanya 1 faktor (dirinya sendiri)","x":-480,"y":-310,"width":230,"height":100,"color":"2"},
		{"id":"unit_chem","type":"text","text":"**<center><font color=\"#92d050\">Proton / Sub-atomik</font></center>**\nBukan atom maupun molekul\nBlok penyusun dasar","x":330,"y":-310,"width":230,"height":100,"color":"2"},
		{"id":"prime_def","type":"text","text":"**<center><font color=\"#00b0f0\">Bilangan Prima</font></center>**\nHanya habis dibagi 1 & dirinya sendiri\nTepat <font color=\"#ffc000\">2 faktor</font>\nContoh: 2, 3, 5, 7, 11, 13...","x":-480,"y":-140,"width":230,"height":130,"color":"4"},
		{"id":"atom_def","type":"text","text":"**<center><font color=\"#00b0f0\">Atom</font></center>**\nSatuan terkecil suatu unsur\nTidak bisa dibagi lagi\nmenjadi unsur lain\nContoh: H, O, C, Fe...","x":330,"y":-140,"width":230,"height":130,"color":"4"},
		{"id":"comp_def","type":"text","text":"**<center><font color=\"#ffc000\">Bilangan Komposit</font></center>**\nBisa difaktorkan menjadi\nbilangan prima\nContoh: 4, 6, 8, 9, 10, 20...","x":-480,"y":70,"width":230,"height":130,"color":"3"},
		{"id":"mol_def","type":"text","text":"**<center><font color=\"#ffc000\">Molekul</font></center>**\nGabungan 2+ atom\ndengan ikatan kimia\nContoh: H₂O, CO₂, NaCl...","x":330,"y":70,"width":230,"height":130,"color":"3"},
		{"id":"fta","type":"text","text":"**<center><font color=\"#00b0f0\">🧮 Fundamental Theorem of Arithmetic</font></center>**\nSetiap bilangan > 1 adalah prima\nATAU hasil kali bilangan prima\n(unik hingga permutasi)","x":-130,"y":280,"width":340,"height":120,"color":"4"},
		{"id":"chem_analogy","type":"text","text":"**<center><font color=\"#ffc000\">⚛️ Analogi Kimia</font></center>**\nSetiap senyawa adalah atom\nATAU gabungan atom\n(dengan ikatan kimia)","x":-130,"y":440,"width":340,"height":120,"color":"3"},
		{"id":"ex1_num","type":"text","text":"**<center>Contoh: 20</font></center>**\n20 = 2 × 2 × 5\n20 = 2² × 5\nFaktorisasi prima unik","x":-520,"y":280,"width":220,"height":120,"color":"3"},
		{"id":"ex1_chem","type":"text","text":"**<center>Contoh: H₂O</font></center>**\nH₂O = H + H + O\n2 atom Hidrogen\n1 atom Oksigen","x":360,"y":280,"width":220,"height":120,"color":"3"},
		{"id":"ex2_num","type":"text","text":"**<center>Contoh: 12</font></center>**\n12 = 2 × 2 × 3\n12 = 2² × 3\nFaktorisasi prima unik","x":-520,"y":440,"width":220,"height":120,"color":"3"},
		{"id":"ex2_chem","type":"text","text":"**<center>Contoh: CO₂</font></center>**\nCO₂ = C + O + O\n1 atom Karbon\n2 atom Oksigen","x":360,"y":440,"width":220,"height":120,"color":"3"},
		{"id":"key_insight","type":"text","text":"**<center>💡 INSIGHT KUNCI</font></center>**\n\n• Prima → tidak bisa dipecah lagi\n  Atom → tidak bisa dipecah lagi (menjadi unsur lain)\n\n• Komposit → kombinasi prima\n  Molekul → kombinasi atom\n\n• Faktorisasi prima = \"rumus kimia\" bilangan\n  Rumus molekul = \"faktorisasi\" atom","x":-160,"y":620,"width":400,"height":200,"color":"6"},
		{"id":"note_1","type":"text","text":"<font color=\"#c0c0c0\">Catatan: Angka 2 adalah satu-satunya prima genap — analog dengan Hidrogen sebagai atom teringan</font>","x":-160,"y":870,"width":400,"height":80,"color":"1"}
	],
